generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /**
   * Pooled connection (Neon pooler) — used by the app at runtime
   */
  url       = env("DATABASE_URL")
  /**
   * Direct connection — used by Prisma Migrate (not the pooler)
   */
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  INTERNAL
  DEALER
  DEPOT
}

enum Role {
  SUPER_ADMIN
  SALES_PERSON_EXECUTIVE
  STANDARD_USER
  DEPOT_MANAGER
  DEALER_ADMIN
  DEALER_USER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum SessionStatus {
  SCHEDULED
  COUNTDOWN
  RECORDING
  PAUSED
  COMPLETED
  CANCELLED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum NotesStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum ReportCategory {
  FUEL_RETAIL
  NON_FUEL_RETAIL
  GENERAL
}

enum ProductCode {
  PMS
  AGO
  LUBRICANTS
  LPG
}

enum DealerOrderStatus {
  DRAFT
  SUBMITTED
  ODOO_SYNC_PENDING
  ODOO_SYNC_FAILED
  QUOTATION_CREATING
  QUOTATION_READY
  PFI_PENDING
  PFI_ISSUED
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_VERIFICATION
  PAYMENT_CONFIRMED
  RELEASED_TO_DEPOT
  LOADING
  LOADED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CLOSED
  REQUIRES_AMENDMENT
  REJECTED
  CANCELLED
  PAYMENT_EXCEPTION
  STOCK_EXCEPTION
  DELIVERY_EXCEPTION
}

enum PaymentState {
  SUBMITTED
  VERIFICATION
  CONFIRMED
  REJECTED
}

model User {
  id                   String              @id @default(cuid())
  firstName            String
  lastName             String
  email                String              @unique
  passwordHash         String?
  department           String
  role                 Role                @default(STANDARD_USER)
  accountType          AccountType         @default(INTERNAL)
  status               UserStatus          @default(PENDING)
  permissions          String              @default("[]")
  dealerOrganizationId String?
  dealerOrganization   DealerOrganization? @relation(fields: [dealerOrganizationId], references: [id], onDelete: SetNull)
  depotId              String?
  depot                Depot?              @relation(fields: [depotId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  lastLoginAt          DateTime?
  /**
   * Set when the password is set or reset; sessions signed in earlier are ended.
   */
  passwordChangedAt    DateTime?

  invitations              InvitationToken[]
  passwordResets           PasswordResetToken[]
  noteSessions             NoteSession[]
  presentations            Presentation[]
  reports                  Report[]
  activityLogs             ActivityLog[]             @relation("ActorLogs")
  ordersCreated            DealerOrder[]             @relation("OrderCreator")
  statusChanges            OrderStatusHistory[]
  conversationParticipants ConversationParticipant[]
  accessRequests           AccessRequest[]           @relation("AccessRequester")
  accessDecisions          AccessRequest[]           @relation("AccessDecider")
  actionItemsDone          ActionItemDone[]
  messagesSent             Message[]                 @relation("MessageSender")
  messageReceipts          MessageReceipt[]
  supportTicketsCreated    SupportTicket[]           @relation("SupportTicketCreator")
  supportTicketsAssigned   SupportTicket[]           @relation("SupportTicketAssignee")
  supportTicketMessages    SupportTicketMessage[]    @relation("SupportTicketMessageAuthor")
  supportTicketAttachments SupportTicketAttachment[] @relation("SupportTicketAttachmentUploader")
  supportTicketEvents      SupportTicketEvent[]      @relation("SupportTicketEventActor")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([accountType])
  @@index([dealerOrganizationId])
  @@index([depotId])
}

model InvitationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model NoteSession {
  id               String           @id @default(cuid())
  name             String
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           SessionStatus    @default(SCHEDULED)
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  durationSeconds  Int?
  timeLimitSeconds Int?
  participants     String           @default("[]")
  audioUrl         String?
  transcript       String?
  transcriptStatus TranscriptStatus @default(PENDING)
  notesStatus      NotesStatus      @default(PENDING)
  notesJson        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  presentation    Presentation?
  actionItemsDone ActionItemDone[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Presentation {
  id            String       @id @default(cuid())
  title         String
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteSessionId String?      @unique
  noteSession   NoteSession? @relation(fields: [noteSessionId], references: [id], onDelete: SetNull)
  slidesJson    String
  presenter     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
}

model Report {
  id          String         @id @default(cuid())
  title       String
  category    ReportCategory @default(GENERAL)
  description String?
  dateFrom    DateTime?
  dateTo      DateTime?
  contentJson String?
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([category])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model DealerOrganization {
  id                    String   @id @default(cuid())
  name                  String
  code                  String   @unique
  /**
   * Odoo res.partner id for this dealer customer
   */
  odooPartnerId         Int?
  /**
   * Odoo res.partner External ID (`__export__.res_partner_…`)
   */
  odooPartnerExternalId String?
  /**
   * JSON array of ProductCode values this dealer may order
   */
  products              String   @default("[\"PMS\",\"AGO\",\"LUBRICANTS\",\"LPG\"]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users            User[]
  stations         Station[]
  orders           DealerOrder[]
  supportTickets   SupportTicket[]
  stockSaleReports StockSaleReport[]

  @@index([name])
  @@index([odooPartnerId])
  @@index([odooPartnerExternalId])
}

model Station {
  id                    String             @id @default(cuid())
  /**
   * Stable slug used for seed/upsert (e.g. banana, nakuru)
   */
  code                  String?            @unique
  name                  String
  /**
   * Company trading name shown as primary label after dealer activation
   */
  tradingName           String?
  dealerOrganizationId  String
  dealerOrganization    DealerOrganization @relation(fields: [dealerOrganizationId], references: [id], onDelete: Cascade)
  /**
   * Odoo res.partner id for this station customer (preferred over org-level)
   */
  odooPartnerId         Int?
  /**
   * Odoo res.partner External ID for this station’s dealer customer
   */
  odooPartnerExternalId String?
  /**
   * Odoo station External ID (account.analytic.account for TRI)
   */
  odooStationExternalId String?
  /**
   * JSON array of ProductCode values for this station (may differ from org defaults later)
   */
  products              String             @default("[\"PMS\",\"AGO\",\"LUBRICANTS\",\"LPG\"]")
  /**
   * Optional station forecourt equipment counts for Stock Sale Reporting.
   * Null until pumps/tanks are configured for the station.
   */
  pumpCount             Int?
  tankCount             Int?
  createdAt             DateTime           @default(now())

  orders           DealerOrder[]
  stockSaleReports StockSaleReport[]
  pumps            StationPump[]
  tanks            StationTank[]
  rttEvents        StationPumpRttEvent[]

  @@index([dealerOrganizationId])
  @@index([odooPartnerId])
  @@index([odooPartnerExternalId])
  @@index([odooStationExternalId])
}

/**
 * Configured fuel dispensers for Stock Sale Reporting (PMS / AGO).
 */
model StationPump {
  id                String                @id @default(cuid())
  stationId         String
  station           Station               @relation(fields: [stationId], references: [id], onDelete: Cascade)
  /**
   * Stable key within the station, e.g. PMS-1
   */
  pumpKey           String
  product           ProductCode
  label             String
  sortOrder         Int                   @default(0)
  /**
   * Last validated closing meter (litres); becomes next report's opening
   */
  lastClosingLitres Float                 @default(0)
  /**
   * False until the first accepted closing (or authorized opening init) is saved.
   */
  meterInitialized  Boolean               @default(false)
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  rttEvents         StationPumpRttEvent[]

  @@unique([stationId, pumpKey])
  @@index([stationId, active, sortOrder])
}

enum StationPumpRttStatus {
  ACTIVE
  VOIDED
}

/**
 * Individual pump test-return (RTT) events — multiple per pump per day.
 */
model StationPumpRttEvent {
  id                   String               @id @default(cuid())
  stationId            String
  station              Station              @relation(fields: [stationId], references: [id], onDelete: Cascade)
  pumpId               String
  pump                 StationPump          @relation(fields: [pumpId], references: [id], onDelete: Cascade)
  pumpKey              String
  product              ProductCode
  tankId               String?
  tankKey              String?
  tankLabel            String?
  volumeLitres         Float
  /**
   * Authoritative server timestamp when the RTT was recorded (UTC).
   */
  eventAt              DateTime
  /**
   * Nairobi business date for aggregation into daily reports.
   */
  reportingDate        DateTime             @db.Date
  /**
   * Required dealer explanation for why RTT was performed (max 250).
   */
  notes                String?
  status               StationPumpRttStatus @default(ACTIVE)
  recordedById         String
  /**
   * Client idempotency key to prevent double-submit.
   */
  submissionKey        String?
  /**
   * Optional technician job-card PDF (storage key under RTT upload root).
   */
  jobCardStorageKey    String?
  jobCardFileName      String?
  jobCardMimeType      String?
  jobCardSizeBytes     Int?
  /**
   * Correction audit (original volume preserved when corrected).
   */
  originalVolumeLitres Float?
  correctionReason     String?
  correctedAt          DateTime?
  correctedById        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([stationId, submissionKey])
  @@index([stationId, reportingDate, status])
  @@index([pumpId, reportingDate, status])
  @@index([recordedById])
}

/**
 * Configured storage tanks for Stock Sale Reporting (PMS / AGO).
 */
model StationTank {
  id                String      @id @default(cuid())
  stationId         String
  station           Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  /**
   * Stable key within the station, e.g. PMS-1
   */
  tankKey           String
  product           ProductCode
  label             String
  sortOrder         Int         @default(0)
  /**
   * Nominal usable capacity in litres for this tank
   */
  capacityLitres    Float
  /**
   * Last validated closing stock; becomes next report's opening
   */
  lastClosingLitres Float       @default(0)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([stationId, tankKey])
  @@index([stationId, active, sortOrder])
}

model Depot {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  users  User[]
  orders DealerOrder[]
}

model OrderSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model DealerOrder {
  id                    String             @id @default(cuid())
  reference             String             @unique
  dealerOrganizationId  String
  dealerOrganization    DealerOrganization @relation(fields: [dealerOrganizationId], references: [id])
  stationId             String
  station               Station            @relation(fields: [stationId], references: [id])
  depotId               String?
  depot                 Depot?             @relation(fields: [depotId], references: [id])
  createdById           String
  createdBy             User               @relation("OrderCreator", fields: [createdById], references: [id])
  status                DealerOrderStatus  @default(DRAFT)
  requestedDeliveryDate DateTime?
  dealerReference       String?
  notes                 String?
  currency              String             @default("KES")
  amountDue             String?
  odooSyncKey           String             @unique
  /**
   * One-time id from the Place Order form; a repeated submit returns the existing order
   */
  submissionKey         String?            @unique
  odooQuotationId       String?
  odooQuotationNumber   String?
  /// When the quotation was saved; the PFI's "SO DATE"
  quotedAt              DateTime?
  odooSyncError         String?
  truckRegistration     String?
  driverName            String?
  transporter           String?
  loadedPmsLitres       Int?
  loadedAgoLitres       Int?
  loadingReference      String?
  loadingStartedAt      DateTime?
  loadingCompletedAt    DateTime?
  sealNumbers           String?
  deliveryNoteRef       String?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  lines          DealerOrderLine[]
  supportTickets SupportTicket[]
  history        OrderStatusHistory[]
  payments       PaymentRecord[]
  documents      OrderDocument[]
  proforma       ProFormaInvoice?

  @@index([dealerOrganizationId])
  @@index([stationId])
  @@index([depotId])
  @@index([status])
  @@index([createdAt])
  @@index([odooQuotationId])
}

model DealerOrderLine {
  id             String      @id @default(cuid())
  orderId        String
  order          DealerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        ProductCode
  quantityLitres Int
  /// Unit price before VAT (KES/L) at quotation time, frozen for the PFI
  unitPriceExVat String?

  @@index([orderId])
}

model ProFormaInvoice {
  id             String      @id @default(cuid())
  orderId        String      @unique
  order          DealerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number         String      @unique
  amount         String
  currency       String      @default("KES")
  issuedAt       DateTime    @default(now())
  odooDocumentId String?
  documentPath   String?
  /// Frozen PFI figures (amount is the total incl. VAT)
  subtotal       String?
  vatAmount      String?
  vatRate        String?
  preparedByName String?
  approvedByName String?

  @@index([number])
}

model PaymentRecord {
  id                   String       @id @default(cuid())
  orderId              String
  order                DealerOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount               String
  bankReference        String?
  transactionReference String?
  paymentDate          DateTime?
  proofPath            String?
  status               PaymentState @default(SUBMITTED)
  note                 String?
  submittedById        String?
  createdAt            DateTime     @default(now())

  @@index([orderId])
  @@index([status])
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  order      DealerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderDocument {
  id          String      @id @default(cuid())
  orderId     String
  order       DealerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String
  fileName    String
  storagePath String
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

enum ConversationKind {
  DIRECT
}

model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind @default(DIRECT)
  /**
   * Stable pair key for direct chats: sorted userIdA:userIdB
   */
  directKey     String?          @unique
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  muted          Boolean      @default(false)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  receipts MessageReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

enum MessageReceiptStatus {
  SENT
  DELIVERED
  READ
}

model MessageReceipt {
  id        String               @id @default(cuid())
  messageId String
  message   Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    MessageReceiptStatus @default(SENT)
  updatedAt DateTime             @updatedAt

  @@unique([messageId, userId])
  @@index([userId])
}

enum AuthAttemptKind {
  LOGIN_FAILURE
  PASSWORD_RESET
}

/// Failed sign-ins and password-reset requests, counted over short windows to lock out guessing (E1).
model AuthAttempt {
  id        String          @id @default(cuid())
  kind      AuthAttemptKind
  /// Normalized (lowercase, trimmed); unknown emails are recorded too.
  email     String
  ip        String
  createdAt DateTime        @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
}

enum AccessRequestStatus {
  PENDING
  GRANTED
  DECLINED
}

/**
 * A staff member asking an Admin for more of the portal (Staff Member Home, "Ask an Admin").
 */
model AccessRequest {
  id          String              @id @default(cuid())
  requesterId String
  requester   User                @relation("AccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /**
   * JSON array of PermissionModule keys, e.g. ["orders","analytics"].
   */
  modules     String
  note        String?
  status      AccessRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?               @relation("AccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@index([status])
  @@index([requesterId])
}

/**
 * An action item from a meeting's notes that its owner ticked as done; keyed by the item's text hash.
 */
model ActionItemDone {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteSessionId String
  noteSession   NoteSession @relation(fields: [noteSessionId], references: [id], onDelete: Cascade)
  itemHash      String
  doneAt        DateTime    @default(now())

  @@unique([userId, noteSessionId, itemHash])
}

/**
 * ——— Support Centre ticketing ———
 */

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_RESPONSE
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketDepartment {
  IT
  FINANCE
  SALES
  SUPPLY
}

enum SupportMessageVisibility {
  DEALER_VISIBLE
  INTERNAL_NOTE
}

enum SupportTicketEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  MESSAGE_ADDED
  ATTACHMENT_ADDED
  RESOLVED
  CLOSED
  REOPENED
}

/**
 * Monotonic counter for human ticket refs (TRN-4587).
 */
model SupportTicketSequence {
  id         String @id @default("default")
  lastNumber Int    @default(4580)
}

model SupportTicket {
  id                   String                  @id @default(cuid())
  reference            String                  @unique
  dealerOrganizationId String
  dealerOrganization   DealerOrganization      @relation(fields: [dealerOrganizationId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User                    @relation("SupportTicketCreator", fields: [createdById], references: [id])
  assigneeId           String?
  assignee             User?                   @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject              String
  description          String
  department           SupportTicketDepartment
  priority             SupportTicketPriority
  status               SupportTicketStatus     @default(OPEN)
  relatedOrderId       String?
  relatedOrder         DealerOrder?            @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  resolutionSummary    String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  messages    SupportTicketMessage[]
  attachments SupportTicketAttachment[]
  events      SupportTicketEvent[]

  @@index([dealerOrganizationId, updatedAt])
  @@index([department, status])
  @@index([createdById])
  @@index([assigneeId])
  @@index([status])
  @@index([relatedOrderId])
}

model SupportTicketMessage {
  id         String                   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User                     @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id])
  body       String
  visibility SupportMessageVisibility @default(DEALER_VISIBLE)
  createdAt  DateTime                 @default(now())

  attachments SupportTicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model SupportTicketAttachment {
  id           String                @id @default(cuid())
  ticketId     String
  ticket       SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId    String?
  message      SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User                  @relation("SupportTicketAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime              @default(now())

  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedById])
}

model SupportTicketEvent {
  id        String                 @id @default(cuid())
  ticketId  String
  ticket    SupportTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      SupportTicketEventType
  fromValue String?
  toValue   String?
  note      String?
  actorId   String?
  actor     User?                  @relation("SupportTicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime               @default(now())

  @@index([ticketId, createdAt])
  @@index([actorId])
}

enum StockSaleReportStatus {
  DRAFT
  CLOSED
}

enum StockSaleReportStage {
  PUMP_METERS
  TANK_DIPS
  WET_STOCK
  MONETARY
}

enum WetStockResolution {
  NONE
  MATCH_DELIVERY
  REVIEW_READINGS
  RECORD_LOSS
  BALANCED
}

enum WetStockState {
  NOT_STARTED
  VARIANCE_DETECTED
  BALANCED
  DELIVERY_MATCHING
  READINGS_UNDER_REVIEW
  VARIANCE_RECORDED
  PENDING_APPROVAL
  RECONCILED
}

enum MonetaryState {
  NOT_STARTED
  INCOMPLETE
  BALANCED
  SHORTAGE
  OVERAGE
}

/**
 * One stock-sale report per station per Nairobi business calendar date (shift model may expand later).
 */
model StockSaleReport {
  id                        String                   @id @default(cuid())
  dealerOrganizationId      String
  dealerOrganization        DealerOrganization       @relation(fields: [dealerOrganizationId], references: [id], onDelete: Cascade)
  stationId                 String
  station                   Station                  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  /**
   * Africa/Nairobi calendar day stored as UTC midnight of that Y-M-D
   */
  reportingDate             DateTime                 @db.Date
  status                    StockSaleReportStatus    @default(DRAFT)
  pumpMetersCompletedAt     DateTime?
  tankDipsCompletedAt       DateTime?
  wetStockCompletedAt       DateTime?
  monetaryCompletedAt       DateTime?
  closedAt                  DateTime?
  closedById                String?
  meterSalesPmsLitres       Float?
  meterSalesAgoLitres       Float?
  tankSalesPmsLitres        Float?
  tankSalesAgoLitres        Float?
  totalSalesLitres          Float?
  expectedRevenueKes        Decimal?                 @db.Decimal(18, 2)
  collectionsKes            Decimal?                 @db.Decimal(18, 2)
  wetResolution             WetStockResolution       @default(NONE)
  wetState                  WetStockState            @default(NOT_STARTED)
  wetVariancePmsLitres      Float?
  wetVarianceAgoLitres      Float?
  wetVarianceTotalLitres    Float?
  wetAbsoluteVarianceLitres Float?
  wetLossReason             String?
  wetLossAcknowledgedAt     DateTime?
  wetLossAcknowledgedById   String?
  /**
   * Snapshotted pump selling prices (KES/L) used for expected sales.
   */
  sellingPricePmsKes        Decimal?                 @db.Decimal(12, 4)
  sellingPriceAgoKes        Decimal?                 @db.Decimal(12, 4)
  expectedPmsKes            Decimal?                 @db.Decimal(18, 2)
  expectedAgoKes            Decimal?                 @db.Decimal(18, 2)
  /**
   * Manual collection totals entered by the dealer (not M-Pesa/card verified imports).
   */
  cashCollectionsKes        Decimal?                 @db.Decimal(18, 2)
  mpesaCollectionsKes       Decimal?                 @db.Decimal(18, 2)
  cardCollectionsKes        Decimal?                 @db.Decimal(18, 2)
  monetaryDifferenceKes     Decimal?                 @db.Decimal(18, 2)
  monetaryState             MonetaryState            @default(NOT_STARTED)
  monetaryDiscrepancyReason String?
  /**
   * Stable human-facing reference, e.g. SSR-KITALE-2026-11-06. Set once on close.
   */
  reportReference           String?                  @unique
  /**
   * Equipment counts snapshotted at close (preserve historical display).
   */
  submittedPumpCount        Int?
  submittedTankCount        Int?
  submittedPumpsPms         Int?
  submittedPumpsAgo         Int?
  submittedTanksPms         Int?
  submittedTanksAgo         Int?
  revision                  Int                      @default(0)
  createdById               String
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  pumpReadings              StockSalePumpReading[]
  tankReadings              StockSaleTankReading[]
  wetAudits                 StockSaleWetAudit[]
  monetaryAudits            StockSaleMonetaryAudit[]

  @@unique([stationId, reportingDate])
  @@index([dealerOrganizationId, reportingDate])
  @@index([stationId, status])
  @@index([createdById])
}

model StockSalePumpReading {
  id            String          @id @default(cuid())
  reportId      String
  report        StockSaleReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  pumpKey       String
  product       ProductCode
  label         String
  sortOrder     Int             @default(0)
  openingLitres Float
  closingLitres Float?
  rttLitres     Float           @default(0)
  salesLitres   Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([reportId, pumpKey])
  @@index([reportId, sortOrder])
}

model StockSaleTankReading {
  id             String          @id @default(cuid())
  reportId       String
  report         StockSaleReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tankKey        String
  product        ProductCode
  label          String
  sortOrder      Int             @default(0)
  capacityLitres Float
  openingLitres  Float
  closingLitres  Float?
  /**
   * Opening − Closing (provisional if receipts unresolved)
   */
  salesLitres    Float?
  ullageLitres   Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([reportId, tankKey])
  @@index([reportId, sortOrder])
}

/**
 * Audit trail for wet-stock reconciliation decisions.
 */
model StockSaleWetAudit {
  id        String          @id @default(cuid())
  reportId  String
  report    StockSaleReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  details   String?
  createdAt DateTime        @default(now())

  @@index([reportId, createdAt])
  @@index([actorId])
}

/**
 * Audit trail for monetary reconciliation drafts and shift closure.
 */
model StockSaleMonetaryAudit {
  id        String          @id @default(cuid())
  reportId  String
  report    StockSaleReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  details   String?
  createdAt DateTime        @default(now())

  @@index([reportId, createdAt])
  @@index([actorId])
}
