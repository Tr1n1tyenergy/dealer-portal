# Neon PostgreSQL — use the pooled connection string for the app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon PostgreSQL — use the direct (non-pooler) connection string for Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Admin"
RESEND_API_KEY=
EMAIL_FROM="Trinity Retail Intelligence <noreply@example.com>"

# Odoo (keep mock for local UI / staging unless intentionally going live)
ODOO_MODE="mock"
ODOO_BASE_URL="https://your-odoo-host.example.com"
ODOO_DATABASE="your-odoo-database-name"
ODOO_USERNAME=""
ODOO_API_KEY=""
# product.product IDs (set from your Odoo catalog)
ODOO_PRODUCT_PMS_ID=""
ODOO_PRODUCT_AGO_ID=""
ODOO_PRODUCT_IK_ID=""
ODOO_PRODUCT_JET_A1_ID=""

# Optional passwords used only by prisma/seed.ts (local/dev). Never use these in production.
DEALER_PASSWORD="replace-with-dealer-demo-password"
DEALER_DEFAULT_PASSWORD="replace-with-official-dealer-temp-password"
DEPOT_PASSWORD="replace-with-depot-demo-password"
