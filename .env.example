# Neon PostgreSQL — use the pooled connection string for the app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon PostgreSQL — use the direct (non-pooler) connection string for Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Production schema migrate (local operator only — never commit real values):
# Create `.env.production.local` with production DATABASE_URL + DIRECT_URL for endpoint
# ep-quiet-wildflower-zaag2pmh only. Do NOT copy .env.staging (ep-old-shape-zacn3ikk).
# Then:
#   TRI_CONFIRM_PRODUCTION_ENDPOINT=ep-quiet-wildflower-zaag2pmh npm run production:migrate:preflight
#   TRI_CONFIRM_PRODUCTION_ENDPOINT=ep-quiet-wildflower-zaag2pmh npm run production:migrate:status
# After approval only:
#   TRI_CONFIRM_PRODUCTION_ENDPOINT=ep-quiet-wildflower-zaag2pmh TRI_ALLOW_PRODUCTION_MIGRATE=1 npm run production:migrate:deploy
#
# Production first SUPER_ADMIN (never use prisma db:seed on production).
# Prefer BOOTSTRAP_ADMIN_PASSWORD_FILE over inline env (avoids shell history):
#   umask 077; printf '%s' '…strong…' > /tmp/tri-bootstrap-pw
#   TRI_CONFIRM_PRODUCTION_ENDPOINT=ep-quiet-wildflower-zaag2pmh \
#   TRI_ALLOW_PRODUCTION_BOOTSTRAP=1 \
#   BOOTSTRAP_ADMIN_EMAIL='admin@yourdomain.com' \
#   BOOTSTRAP_ADMIN_PASSWORD_FILE=/tmp/tri-bootstrap-pw \
#     npm run production:bootstrap:admin -- --dry-run
#   rm -f /tmp/tri-bootstrap-pw
#
# First Vercel launch with mock Odoo — recommended:
#   TRI_LAUNCH_MODE=staff_preview
#   ODOO_MODE=mock
# Dealer commercial orders stay blocked until live Odoo is ready.

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
SUPER_ADMIN_EMAIL="admin@example.com"
# Required for local/staging `npm run db:seed` (no default; never use production endpoint)
SUPER_ADMIN_PASSWORD="replace-with-a-strong-unique-seed-password"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Admin"
RESEND_API_KEY=
EMAIL_FROM="Trinity Retail Intelligence <noreply@example.com>"

# Odoo (keep mock for local UI / staging unless intentionally going live)
ODOO_MODE="mock"
ODOO_BASE_URL="https://your-odoo-host.example.com"
ODOO_DATABASE="your-odoo-database-name"
ODOO_USERNAME=""
ODOO_API_KEY=""
# Product External IDs — confirmed defaults in code are PMSL001 / AGOL001.
# Only set these to override:
# ODOO_PRODUCT_PMS_EXTERNAL_ID="__export__.product_template_56638_95395aa6"
# ODOO_PRODUCT_AGO_EXTERNAL_ID="__export__.product_template_56635_9d243ec3"
ODOO_PRODUCT_PMS_EXTERNAL_ID=""
ODOO_PRODUCT_AGO_EXTERNAL_ID=""
# Legacy numeric product.product IDs (fallback only)
ODOO_PRODUCT_PMS_ID=""
ODOO_PRODUCT_AGO_ID=""
ODOO_PRODUCT_IK_ID=""
ODOO_PRODUCT_JET_A1_ID=""
# Source location candidates are stock.quant External IDs (resolved to location_id).
# Defaults = PMS LOCAL quant per warehouse. Override to test another candidate:
# ODOO_SOURCE_LOCATION_KPC_ELDORET_EXTERNAL_ID="__export__.stock_quant_11568_fc1e067b"
ODOO_SOURCE_LOCATION_KPC_ELDORET_EXTERNAL_ID=""
ODOO_SOURCE_LOCATION_KPC_NAKURU_EXTERNAL_ID=""
ODOO_SOURCE_LOCATION_KPC_KISUMU_EXTERNAL_ID=""
ODOO_SOURCE_LOCATION_LAKE_OIL_NRB_EXTERNAL_ID=""

# Optional passwords used only by prisma/seed.ts (local/dev). Never use these in production.
DEALER_PASSWORD="replace-with-dealer-demo-password"
DEALER_DEFAULT_PASSWORD="replace-with-official-dealer-temp-password"
DEPOT_PASSWORD="replace-with-depot-demo-password"
